---
// src/layouts/Layout.astro
import '../styles/global.css';
import TesseractLogo from '../components/TesseractLogo.astro';

interface Props {
  title?: string;
}

const { title = "USD WG - OpenUSD Working Group" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <style is:global>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #fafafa;
      color: #18181b;
    }
    pre, code {
      font-family: 'JetBrains Mono', monospace;
    }
    .glass-pinned {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(228, 228, 231, 0.85);
    }
  </style>
</head>
<body class="min-h-full flex flex-col antialiased pb-20">

  <!-- ============================================== -->
  <!-- HEADER: (tesseract) USD WG / games (current)   -->
  <!-- ============================================== -->
  <header class="w-full bg-white border-b border-zinc-200 sticky top-0 z-30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-24 sm:h-28 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <TesseractLogo />
        <div class="flex flex-col justify-center">
          <div class="flex items-center gap-2">
            <a href="/" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 hover:text-zinc-700 transition-colors">
              USD WG
            </a>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-700 border border-zinc-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              OpenUSD
            </span>
          </div>
          <div class="flex items-center gap-2 mt-0.5 text-sm font-medium">
            <span class="text-zinc-400 text-xs font-mono uppercase tracking-wider">Group:</span>
            <div class="flex items-center gap-1.5">
              <span id="currentGroupBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs sm:text-sm font-semibold transition-all duration-300 bg-purple-100 text-purple-800 border border-purple-200">
                <span id="currentGroupDot" class="w-2 h-2 rounded-full bg-purple-600 transition-colors duration-300"></span>
                <span id="currentGroupName" class="tracking-tight lowercase">games</span>
              </span>
              <span class="text-xs text-zinc-400 font-mono">(current)</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://github.com/PixarAnimationStudios/OpenUSD" target="_blank" rel="noreferrer" class="p-2 rounded-lg text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 transition-colors" title="OpenUSD GitHub">
          <!-- Width & Height explicitly hard-coded as fallbacks -->
          <svg class="w-5 h-5" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- ============================================== -->
  <!-- MAIN CONTENT CONTAINER                         -->
  <!-- ============================================== -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8">
    <slot />
  </main>

  <!-- ============================================== -->
  <!-- PINNED BOTTOM NAV BAR                          -->
  <!-- ============================================== -->
  <footer class="fixed bottom-0 left-0 right-0 w-full glass-pinned z-40 py-3 px-4 sm:px-8">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-4 text-xs sm:text-sm">
      <nav class="flex items-center gap-2 flex-wrap">
        <a href="#groups" class="px-2.5 py-1 rounded-md text-zinc-700 hover:bg-zinc-100 font-medium">Working Groups</a>
        <span class="text-zinc-300">/</span>
        <a href="#specs" class="px-2.5 py-1 rounded-md text-zinc-700 hover:bg-zinc-100 font-medium">Spec & Schemas</a>
        <span class="text-zinc-300">/</span>
        <a href="/" class="px-2.5 py-1 rounded-md text-blue-600 bg-blue-50 font-semibold">Blog Archive</a>
        <span class="text-zinc-300">/</span>
        <a href="https://github.com/PixarAnimationStudios/OpenUSD" target="_blank" class="px-2.5 py-1 rounded-md text-zinc-700 hover:bg-zinc-100 font-medium">GitHub</a>
      </nav>
      <div class="hidden sm:flex items-center gap-2 font-mono text-[11px] text-zinc-500">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping"></span>
        <span>Engine: <strong class="text-zinc-800">ZW @ 1.0x</strong></span>
      </div>
    </div>
  </footer>

  <script>
    window.addEventListener('usdwg:groupchange', ((e: CustomEvent) => {
      const g = e.detail;
      const name = document.getElementById('currentGroupName');
      const badge = document.getElementById('currentGroupBadge');
      const dot = document.getElementById('currentGroupDot');
      if (name) name.innerText = g.name;
      if (badge) badge.className = `inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs sm:text-sm font-semibold transition-all duration-300 ${g.badgeBg} ${g.badgeText} ${g.badgeBorder}`;
      if (dot) dot.className = `w-2 h-2 rounded-full ${g.badgeDot} transition-colors duration-300`;
    }) as EventListener);
  </script>
</body>
</html>
