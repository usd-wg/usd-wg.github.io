---
// src/pages/calendar.astro
/* STREAMING_CHUNK:Importing layout and setting page metadata */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rolling Calendar - USD Working Group">
  <div class="max-w-4xl mx-auto space-y-8">

    <!-- Header banner -->
    <!-- STREAMING_CHUNK:Rendering header section and time zone indicator -->
    <div class="border-b border-zinc-200 pb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            Live Rolling Schedule
          </span>
          <span class="text-xs text-zinc-400 font-mono">Auto-Computed</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">Working Group Calendar</h1>
        <p class="text-sm text-zinc-500 mt-1">
          Prior, current, and upcoming community syncs across all OpenUSD groups.
        </p>
      </div>

      <!-- Timezone badge -->
      <div class="bg-zinc-100 border border-zinc-200 px-3 py-2 rounded-xl text-xs font-mono text-zinc-600 shrink-0">
        <div>Reference: <span class="font-bold text-zinc-900">America/Los_Angeles (PT)</span></div>
        <div id="localTimeIndicator" class="text-zinc-500 text-[11px] mt-0.5">Detecting your time...</div>
      </div>
    </div>

    <!-- Calendar container dynamically populated by client script -->
    <!-- STREAMING_CHUNK:Rendering calendar schedule cards container -->
    <div id="calendarContainer" class="space-y-6">
      <div class="p-8 text-center text-zinc-400 text-sm font-mono animate-pulse">
        Computing rolling meeting instances...
      </div>
    </div>

    <!-- Quick info callout -->
    <!-- STREAMING_CHUNK:Rendering instructions callout card -->
    <div class="bg-zinc-50 rounded-xl border border-zinc-200 p-5 text-xs text-zinc-600 space-y-2">
      <div class="font-semibold text-zinc-900 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Meeting Information &amp; LFX Zoom Protocol</span>
      </div>
      <p>
        Meetings are hosted via Linux Foundation / Academy Software Foundation (ASWF) Zoom infrastructure. Passwords are built into the join links. If daylight saving transitions occur, meetings remain pinned to the specified San Francisco local clock time.
      </p>
    </div>

  </div>

  <!-- Client-side schedule computation script -->
  <!-- STREAMING_CHUNK:Configuring meeting recurrence schedule definitions -->
  <script>
    // Meeting definitions with schedule rules and Zoom links
    const MEETINGS = [
      {
        id: 'main',
        name: 'USD Working Group Meeting',
        group: 'Main',
        color: 'amber',
        timeWindow: '1:00 PM – 2:00 PM PT',
        startHour: 13,
        startMin: 0,
        endHour: 14,
        endMin: 0,
        rule: 'biweekly-wednesday',
        // Anchor reference: Wed, Oct 21, 2026 (or earlier recurring Wed)
        anchorDateStr: '2026-10-21',
        description: 'Bi-weekly general working group sync for core architecture, schemas, and PRs.',
        zoomUrl: 'https://zoom-lfx.platform.linuxfoundation.org/meeting/96955375634?password=f8dd722d-2a2b-41bb-9fc7-f09aacaf11b2'
      },
      {
        id: 'games',
        name: 'USD Games Interest Group',
        group: 'Games',
        color: 'purple',
        timeWindow: '9:00 AM – 10:00 AM PT',
        startHour: 9,
        startMin: 0,
        endHour: 10,
        endMin: 0,
        rule: 'monthly-3rd-wednesday',
        description: 'Monthly sync focusing on runtime stages, zero-copy feeds, and engine interop.',
        zoomUrl: 'https://zoom-lfx.platform.linuxfoundation.org/meeting/94591033949?password=e674c27a-9055-4e22-8711-fe013d73552e'
      },
      {
        id: 'assets-emea',
        name: 'USD WG Assets Interest Group (EMEA)',
        group: 'Assets',
        color: 'emerald',
        timeWindow: '9:00 AM – 10:00 AM PT',
        startHour: 9,
        startMin: 0,
        endHour: 10,
        endMin: 0,
        rule: 'every-4-weeks',
        anchorDateStr: '2026-10-01', // Thursday, Oct 1
        description: 'Asset structure, schemas, and URI resolvers timed for EMEA / Americas timezones.',
        zoomUrl: 'https://zoom-lfx.platform.linuxfoundation.org/meeting/96587970819?password=0f1315bc-f774-44d5-a7ca-df987d2a839d'
      },
      {
        id: 'camera',
        name: 'USD Camera Interest Group',
        group: 'Camera',
        color: 'sky',
        timeWindow: '11:30 AM – 12:30 PM PT',
        startHour: 11,
        startMin: 30,
        endHour: 12,
        endMin: 30,
        rule: 'every-4-weeks',
        anchorDateStr: '2026-10-12', // Monday, Oct 12
        description: 'Physical camera schemas, optical distortion, and virtual production lenses.',
        zoomUrl: 'https://zoom-lfx.platform.linuxfoundation.org/meeting/98871487845?password=775055cc-070b-4b93-bd28-11aecc5b3430'
      },
      {
        id: 'assets-apac',
        name: 'USD WG Assets Interest Group (APAC)',
        group: 'Assets',
        color: 'emerald',
        timeWindow: '1:00 PM – 2:00 PM PT',
        startHour: 13,
        startMin: 0,
        endHour: 14,
        endMin: 0,
        rule: 'every-4-weeks',
        anchorDateStr: '2026-10-15', // Thursday, Oct 15
        description: 'Asset pipeline sync timed for APAC and US West Coast participation.',
        zoomUrl: 'https://zoom-lfx.platform.linuxfoundation.org/meeting/99264283658?password=57f9fbab-c6da-4921-8445-0936be72507a'
      }
    ];

    // --- RECURRENCE COMPUTATION HELPERS ---
    /* STREAMING_CHUNK:Implementing recurrence math helpers */
    const MS_PER_DAY = 86400000;

    // Returns date of the 3rd Wednesday for a given year & month (0-indexed month)
    function get3rdWednesdayOfMonth(year: number, month: number) {
      let count = 0;
      for (let day = 1; day <= 31; day++) {
        const d = new Date(year, month, day);
        if (d.getMonth() !== month) break;
        if (d.getDay() === 3) { // 3 = Wednesday
          count++;
          if (count === 3) return d;
        }
      }
      return null;
    }

    // Calculates Prior, Current, and Next meeting for a definition relative to "now"
    function computeInstances(meeting: typeof MEETINGS[0], now: Date) {
      const instances: { start: Date; end: Date }[] = [];

      if (meeting.rule === 'biweekly-wednesday' || meeting.rule === 'every-4-weeks') {
        const intervalDays = meeting.rule === 'biweekly-wednesday' ? 14 : 28;
        const [aY, aM, aD] = meeting.anchorDateStr.split('-').map(Number);
        const anchor = new Date(aY, aM - 1, aD);

        // Find closest index k relative to anchor
        const diffDays = Math.round((now.getTime() - anchor.getTime()) / MS_PER_DAY);
        const approxK = Math.floor(diffDays / intervalDays);

        // Sample instances around now (-2 to +3 intervals)
        for (let k = approxK - 2; k <= approxK + 3; k++) {
          const d = new Date(anchor.getTime() + k * intervalDays * MS_PER_DAY);
          const start = new Date(d.getFullYear(), d.getMonth(), d.getDate(), meeting.startHour, meeting.startMin);
          const end = new Date(d.getFullYear(), d.getMonth(), d.getDate(), meeting.endHour, meeting.endMin);
          instances.push({ start, end });
        }
      } else if (meeting.rule === 'monthly-3rd-wednesday') {
        const currYear = now.getFullYear();
        const currMonth = now.getMonth();

        // Sample 5 months centered on current month
        for (let offset = -2; offset <= 2; offset++) {
          const testDate = new Date(currYear, currMonth + offset, 1);
          const wed3 = get3rdWednesdayOfMonth(testDate.getFullYear(), testDate.getMonth());
          if (wed3) {
            const start = new Date(wed3.getFullYear(), wed3.getMonth(), wed3.getDate(), meeting.startHour, meeting.startMin);
            const end = new Date(wed3.getFullYear(), wed3.getMonth(), wed3.getDate(), meeting.endHour, meeting.endMin);
            instances.push({ start, end });
          }
        }
      }

      // Sort chronologically
      instances.sort((a, b) => a.start.getTime() - b.start.getTime());

      // Classify Prior, Current, and Next
      let prior = null;
      let current = null;
      let next = null;

      for (let i = 0; i < instances.length; i++) {
        const inst = instances[i];
        if (now >= inst.start && now <= inst.end) {
          current = inst;
          prior = instances[i - 1] || null;
          next = instances[i + 1] || null;
          break;
        } else if (now < inst.start) {
          next = inst;
          prior = instances[i - 1] || null;
          break;
        }
      }

      // If prior wasn't determined yet, last past instance
      if (!prior && instances.length > 0 && now > instances[instances.length - 1].end) {
        prior = instances[instances.length - 1];
      }

      return { prior, current, next };
    }

    /* STREAMING_CHUNK:Formatting dates and labels */
    function formatDateNice(date: Date | null) {
      if (!date) return 'None recorded';
      return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
    }

    function getRelativeDays(targetDate: Date, now: Date) {
      const targetMidnight = new Date(targetDate.getFullYear(), targetDate.getMonth(), targetDate.getDate());
      const nowMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const diffDays = Math.round((targetMidnight.getTime() - nowMidnight.getTime()) / MS_PER_DAY);

      if (diffDays === 0) return 'Today';
      if (diffDays === 1) return 'Tomorrow';
      if (diffDays > 1) return `in ${diffDays} days`;
      if (diffDays === -1) return 'Yesterday';
      return `${Math.abs(diffDays)} days ago`;
    }

    // Badge styling mapping
    const BADGE_STYLES: Record<string, string> = {
      purple: 'bg-purple-100 text-purple-800 border-purple-200',
      sky: 'bg-sky-100 text-sky-800 border-sky-200',
      emerald: 'bg-emerald-100 text-emerald-800 border-emerald-200',
      amber: 'bg-amber-100 text-amber-800 border-amber-200'
    };

    /* STREAMING_CHUNK:Rendering calendar cards into DOM */
    function renderCalendar() {
      const container = document.getElementById('calendarContainer');
      const timeInd = document.getElementById('localTimeIndicator');
      if (!container) return;

      const now = new Date();
      if (timeInd) {
        timeInd.innerText = `Your local time: ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      }

      container.innerHTML = '';

      MEETINGS.forEach(m => {
        const { prior, current, next } = computeInstances(m, now);
        const badgeClass = BADGE_STYLES[m.color] || 'bg-zinc-100 text-zinc-800 border-zinc-200';

        const isCurrentlyHappening = current !== null;
        const targetNext = current ? current : next;

        const card = document.createElement('div');
        card.className = 'bg-white rounded-2xl border border-zinc-200 p-6 sm:p-7 shadow-xs hover:border-zinc-300 transition-all';

        card.innerHTML = `
          <!-- Header of card -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 pb-4 border-b border-zinc-100">
            <div>
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeClass}">
                  ${m.group}
                </span>
                <span class="text-xs text-zinc-400 font-mono">•</span>
                <span class="text-xs text-zinc-500 font-mono">${m.timeWindow}</span>
                ${isCurrentlyHappening ? `
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-200 animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                    HAPPENING NOW
                  </span>
                ` : ''}
              </div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-900">${m.name}</h2>
              <p class="text-xs sm:text-sm text-zinc-500 mt-1">${m.description}</p>
            </div>

            <!-- Join Zoom Button -->
            <a href="${m.zoomUrl}" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all shrink-0 ${
                 isCurrentlyHappening
                   ? 'bg-rose-600 text-white hover:bg-rose-700 shadow-sm animate-bounce'
                   : 'bg-zinc-900 text-white hover:bg-zinc-800'
               }">
              <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.5 4.5A2.5 2.5 0 002 7v10a2.5 2.5 0 002.5 2.5h10a2.5 2.5 0 002.5-2.5v-2.2l4.2 2.8A1 1 0 0023 16.8V7.2a1 1 0 00-1.8-.8L17 9.2V7a2.5 2.5 0 00-2.5-2.5h-10z"/>
              </svg>
              <span>Join Zoom</span>
            </a>
          </div>

          <!-- Rolling Calendar 3-State Column (Prior, Current, Next) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-4 text-xs font-mono">

            <!-- Prior Meeting -->
            <div class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-200 flex flex-col justify-between">
              <span class="text-zinc-400 font-bold tracking-wider uppercase text-[10px]">1. Prior Meeting</span>
              <div class="mt-2">
                <div class="text-zinc-800 font-medium">${formatDateNice(prior?.start ?? null)}</div>
                <div class="text-[11px] text-zinc-400 mt-0.5">${prior ? getRelativeDays(prior.start, now) : 'None recorded'}</div>
              </div>
            </div>

            <!-- Current State / Today -->
            <div class="p-3.5 rounded-xl border flex flex-col justify-between ${
              isCurrentlyHappening
                ? 'bg-rose-50 border-rose-200'
                : 'bg-zinc-50 border-zinc-200'
            }">
              <span class="font-bold tracking-wider uppercase text-[10px] ${
                isCurrentlyHappening ? 'text-rose-600' : 'text-zinc-400'
              }">
                2. Current State
              </span>
              <div class="mt-2">
                <div class="font-semibold ${isCurrentlyHappening ? 'text-rose-900' : 'text-zinc-800'}">
                  ${isCurrentlyHappening ? 'In Session Right Now' : 'Between Meetings'}
                </div>
                <div class="text-[11px] text-zinc-500 mt-0.5">
                  ${isCurrentlyHappening ? m.timeWindow : 'No session in progress'}
                </div>
              </div>
            </div>

            <!-- Next Meeting -->
            <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200 flex flex-col justify-between">
              <span class="text-blue-600 font-bold tracking-wider uppercase text-[10px]">3. Next Upcoming</span>
              <div class="mt-2">
                <div class="text-blue-950 font-bold text-sm">
                  ${formatDateNice(targetNext?.start ?? null)}
                </div>
                <div class="text-[11px] text-blue-600 font-semibold mt-0.5">
                  ${targetNext ? getRelativeDays(targetNext.start, now) : 'TBD'}
                </div>
              </div>
            </div>

          </div>
        `;

        container.appendChild(card);
      });
    }

    // Initialize and refresh periodically
    /* STREAMING_CHUNK:Initializing live render loop */
    renderCalendar();
    setInterval(renderCalendar, 60000); // Re-calculate every 60 seconds
  </script>
</Layout>